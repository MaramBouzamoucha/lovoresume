{% extends 'admin.html.twig' %}
{% block admin_content %}
    <h1>Ajout de template CV</h1>
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data','data-turbo': 'false'}}) }}
    {{ form_row(form.fileName) }}
    {{ form_row(form.filePath) }}

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}
    <h2 class="mt-4">Liste des Templates</h2>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Nom du fichier</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for template in templates %}
            <tr>
                <td>{{ template.id }}</td>
                <td>{{ template.fileName }}</td>
                <td>
                    <a href="{{ path('admin_edit_template', {'id': template.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                    <a href="{{ path('admin_delete_template', {'id': template.id}) }}" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce template ?');">Supprimer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="text-center">Aucun template disponible.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <style>
    .btn-danger {
    background-color: #3e3e3e ;
    border-color: #3e3e3e;
    color: white;
    }

    .btn-primary {
    background-color: #e6c158;
    border-color: #e6c158;
    }

    .btn-warning {
    background-color:  #e6c158;
    border-color:  #e6c158;
    color: black;
    }



    body {
    font-family: Arial, sans-serif;
    background-color: #f5f7fa;
    padding: 20px;
    }

    table {
    width: 60%;
    border-collapse: collapse;
    background: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);
    }

    th, td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
    }

    th {
    background-color: #007bff;
    color: white;
    font-weight: bold;
    }

    tr:hover {
    background-color: #f1f1f1;
    }
    a {
    text-decoration: none;
    color: #007bff;
    font-weight: bold;
    }

    </style>




{% endblock %}
