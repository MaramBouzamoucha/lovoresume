{% extends 'base.html.twig' %}

{% block title %}Ajouter un recruteur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>

        :root {
            --primary-color: #e6c158;
            --secondary-color: #343a40;
            --border-color: #ddd;
            --error-color: #dc3545;
        }

        body {
            background-color: #ffffff !important;
        }

        .container {
            background-color: #ffffff !important;
        }
        .recruiter-form-container {
            max-width: 600px;
            margin: 0 auto;
            padding: 2rem;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .form-title {
            color: var(--secondary-color);
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--primary-color);
            font-weight: 600;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            font-weight: 500;
            color: var(--secondary-color);
        }

        .form-control {
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 0.75rem;
            background-color: #ffffff;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(230, 193, 88, 0.25);
        }

        .btn-custom-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .btn-custom-primary:hover {
            background-color: #d1af4e;
            border-color: #d1af4e;
        }

        .btn-custom-primary:focus {
            box-shadow: 0 0 0 0.2rem rgba(230, 193, 88, 0.5);
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .btn-custom-primary:active {
            animation: pulse 0.3s;
        }

        .invalid-feedback {
            color: var(--error-color);
            display: block;
            margin-top: 0.25rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="recruiter-form-container">
            <h2 class="text-center form-title">Ajouter un recruteur</h2>

            {{ form_start(form) }}

            <div class="form-group">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, { 'attr': {'class': 'form-control', 'autocomplete': 'name'} }) }}
                {{ form_errors(form.nom, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.prenom) }}
                {{ form_widget(form.prenom, { 'attr': {'class': 'form-control', 'autocomplete': 'given-name'} }) }}
                {{ form_errors(form.prenom, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, { 'attr': {'class': 'form-control', 'autocomplete': 'email'} }) }}
                {{ form_errors(form.email, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.password) }}
                {{ form_widget(form.password, { 'attr': {'class': 'form-control', 'autocomplete': 'new-password'} }) }}
                {{ form_errors(form.password, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.confirm_password) }}
                {{ form_widget(form.confirm_password, { 'attr': {'class': 'form-control', 'autocomplete': 'new-password'} }) }}
                {{ form_errors(form.confirm_password, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn btn-custom-primary btn-block" data-turbo="false">Ajouter</button>
                </div>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}