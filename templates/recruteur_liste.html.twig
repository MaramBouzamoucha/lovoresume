{% extends 'admin.html.twig' %}

{% block admin_content %}
    <div class="page-container">
        <div class="header-container">
            <h2>Liste des Recruteurs</h2>
        </div>

        <div class="table-container">
            <table class="table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Actions</th>
                    <th>
                        <a href="{{ path('ajouter_recruteur') }}" class="btn btn-primary btn-add">
                            <span class="plus-symbol">+</span> Ajouter un Recruteur
                        </a>
                    </th>
                </tr>
                </thead>
                <tbody>
                {% for recruteur in recruteurs %}
                    <tr>
                        <td>{{ recruteur.id }}</td>
                        <td>{{ recruteur.nom }}</td>
                        <td>{{ recruteur.email }}</td>
                        <td>
                            <a href="{{ path('recruteur_modifier', {id: recruteur.id}) }}" class="btn btn-warning">Modifier</a>
                            <a href="{{ path('recruteur_supprimer', {id: recruteur.id}) }}" class="btn btn-danger" onclick="return confirm('Voulez-vous vraiment supprimer ce recruteur ?');">Supprimer</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">Aucun recruteur trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>

        :root {
            --primary-color: #b89328;
            --secondary-color: #343a40;
            --light-color: #f9f9f9;
            --border-color: #ddd;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f4f4f4;
        }
        .navbar-logo a {
            color: white;
            font-size: 1.5rem;
            font-weight: bold;
            text-decoration: none;
        }
        .navbar-menu ul {
            display: flex;
            list-style: none;
        }
        .navbar-menu li {
            position: relative;
            margin-left: 1.5rem;
        }

        .navbar-menu a {
            color: white;
            text-decoration: none;
            padding: 0.5rem;
            display: block;
            transition: color 0.3s;
        }

        .navbar-menu a:hover, .navbar-menu a.active {
            color: var(--primary-color);
        }

        .dropdown-toggle {
            display: flex;
            align-items: center;
        }

        .dropdown-icon::after {
            content: "▼";
            font-size: 0.7rem;
            margin-left: 0.5rem;
        }



        .navbar-menu li:hover .dropdown-menu {
            display: block;
        }

        .dropdown-menu li {
            margin: 0;
        }

        .dropdown-menu a {
            padding: 0.75rem 1rem;
        }

        .dropdown-menu a:hover {
            background-color: rgba(184, 147, 40, 0.2);
        }
        .page-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .header-container {
            margin-bottom: 2rem;
            border-bottom: 2px solid var(--primary-color);
            padding-bottom: 1rem;
        }

        .header-container h2 {
            color: var(--secondary-color);
        }

        .table-container {
            overflow-x: auto;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
        }

        .table th, .table td {
            padding: 1rem;
            text-align: center;
            border: 1px solid var(--border-color);
        }

        .table th {
            background-color: var(--primary-color);
            color: white;
            font-weight: bold;
        }

        .table td {
            background-color: var(--light-color);
        }

        .table tr:nth-child(even) td {
            background-color: #f0f0f0;
        }

        .table tr:hover td {
            background-color: #e9e9e9;
        }

        .btn {
            padding: 0.5rem 1rem;
            border-radius: 4px;
            text-decoration: none;
            color: white;
            font-weight: bold;
            display: inline-block;
            transition: opacity 0.3s;
            border: none;
            cursor: pointer;
        }

        .btn:hover {
            opacity: 0.9;
        }

        .btn-primary, .btn-add {
            background-color: var(--primary-color);
        }

        .btn-warning {
            background-color: var(--primary-color);
        }

        .btn-danger {
            background-color: var(--secondary-color);
        }

        .plus-symbol {
            font-weight: bold;
            font-size: 1.2rem;
        }



        .footer-section h3 {
            color: var(--primary-color);
            margin-bottom: 1rem;
            font-size: 1.2rem;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section ul li {
            margin-bottom: 0.5rem;
        }

        .footer-section a {
            color: white;
            text-decoration: none;
            transition: color 0.3s;
        }

        .footer-section a:hover {
            color: var(--primary-color);
        }

        .footer-bottom {
            background-color: rgba(0, 0, 0, 0.2);
            padding: 1rem 0;
            text-align: center;
            font-size: 0.9rem;
        }

        /* Responsive Design */
        @media screen and (max-width: 768px) {
            .navbar {
                flex-direction: column;
                padding: 1rem;
            }

            .navbar-menu {
                width: 100%;
                margin-top: 1rem;
            }

            .navbar-menu ul {
                flex-direction: column;
                width: 100%;
            }

            .navbar-menu li {
                margin: 0;
                text-align: center;
                padding: 0.5rem 0;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .dropdown-menu {
                position: static;
                width: 100%;
                box-shadow: none;
                display: none;
            }

            .navbar-menu li:hover .dropdown-menu {
                display: block;
            }

            .footer-section {
                flex: 100%;
                text-align: center;
            }
        }
    </style>
{% endblock %}